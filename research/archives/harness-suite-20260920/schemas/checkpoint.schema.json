{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "hse-checkpoint-v1",
  "type": "object",
  "required": ["schema_version", "experiment_id", "batch_id", "sequence", "created_at", "config_sha256", "manifest_sha256", "completed_trials", "pending_trials", "retryable_failures", "artifact_index"],
  "properties": {
    "schema_version": {"const": "hse-checkpoint-v1"},
    "experiment_id": {"type": "string"},
    "batch_id": {"type": "string"},
    "sequence": {"type": "integer", "minimum": 0},
    "created_at": {"type": "string"},
    "config_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "manifest_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "completed_trials": {"type": "array", "items": {"type": "string"}},
    "pending_trials": {"type": "array", "items": {"type": "string"}},
    "retryable_failures": {"type": "array", "items": {"type": "string"}},
    "artifact_index": {"type": "object", "additionalProperties": {"type": "string"}},
    "last_event_offset": {"type": ["integer", "null"], "minimum": 0}
  },
  "additionalProperties": false
}
