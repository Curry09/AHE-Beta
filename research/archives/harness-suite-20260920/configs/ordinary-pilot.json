      "fixed_followups": false,
      "historical_persona_loop": true
    }
  },
  "timeouts": {
    "official_timeout_source": "task_metadata_or_benchmark_protocol",
    "fallback_trial_seconds": 1800,
    "sandbox_create_seconds": 1200,
    "infrastructure_retry_limit": 2
