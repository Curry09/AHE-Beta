  "profiles": {
    "ordinary_1": {
      "task_ids": ["O03"],
      "role": "canary_not_population_estimate"
    },
    "ordinary_4": {
      "task_ids": ["O03", "O09", "O14", "O18"],
      "role": "first_interpretable_task_only_point"
    }
  },
  "execution_rules": {
    "nested_sets": true,
    "same_tasks_across_conditions": true,
    "retry_only_infrastructure_invalid": true,
    "completed_trials_are_immutable": true,
    "grader_runs_inside_sandbox": true,
    "delete_sandbox_after_artifact_download": true,
    "all_roles_inside_harbor_task": true,
    "forbid_openrouter_fallback": true
