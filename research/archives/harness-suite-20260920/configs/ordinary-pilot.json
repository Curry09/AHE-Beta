    "event_ledger": "events.jsonl",
    "checkpoint": "checkpoints/ckpt-{sequence:06d}.json",
    "checkpoint_artifact": "checkpoints/ckpt-{sequence:06d}.tar.gz"
  },
  "freeze_requirements": [
    "Use the frozen ordinary task records O03, O09, O14, and O18 in task-manifest.json.",
