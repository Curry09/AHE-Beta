{
  "schema_version": "hse-evolution-plan-v1",
  "plan_id": "ordinary-1-4-five-rounds-20260921",
  "status": "prepared-control-plane",
  "purpose": "Compare two independent five-round harness evolution runs with N=1 and N=4 ordinary task sets.",
  "freeze": {
    "task_record": "../freeze-record.json",
    "task_manifest": "../task-manifest.json",
    "harness_id": "baseline-v0-cade14d",
    "harness_sha256": "dd7cdd91a4dc170af3662cdca28d2ed9fbd0dd2676e57ce9a4041146a488e011"
  },
  "rounds": {
    "count": 5,
    "initial_revision": "baseline-v0-cade14d",
    "lineage": "independent_per_experiment",
    "carry_forward": "released_harness_revision",
    "rerun_policy": "resume_last_incomplete_round_only",
    "checkpoint": "after_user_evaluation_and_after_release"
  },
  "pipeline": [
    "harbor_daytona_user_evaluation",
    "persist_sessions_traces_grader_outputs",
    "local_boyue_design",
    "local_boyue_development",
    "mechanical_owner_gate",
    "release_or_keep_previous_revision",
    "round_checkpoint"
  ],
  "roles": {
    "harness": {
      "provider": "openrouter",
      "model": "z-ai/glm-5.3-flash",
      "execution": "harbor_on_daytona"
    },
    "user_simulator": {
      "provider": "openrouter",
      "model": "z-ai/glm-5.3-flash",
      "execution": "same_daytona_trial_as_harness",
      "implementation": "historical_agentic_persona_loop"
    },
    "designer": {
      "provider": "boyue",
      "model": "glm-5.3",
      "execution": "local"
    },
    "developer": {
      "provider": "boyue",
      "model": "glm-5.3",
      "execution": "local"
    },
    "pm": {
      "enabled": false,
      "n_divergents": 0
    },
    "owner": {
      "mode": "mechanical",
      "review": false,
      "n_owners": 0
    }
  },
  "timeouts": {
    "official_agent_timeout_source": "task_metadata_or_1800_fallback",
    "fallback_agent_seconds": 1800,
    "outer_rule": "official_agent_timeout_seconds + 600",
    "outer_grace_seconds": 600,
    "grace_purpose": "artifact_and_checkpoint_persistence_only"
  },
  "seed_policy": {
    "assignment": "fixed_per_task_across_rounds",
    "reason": "isolate harness revision changes from user-simulator sampling noise"
  },
  "execution": {
    "sandbox_provider": "daytona",
    "sandbox_per_trial": true,
    "delete_after_artifact_download": true,
    "current_safe_daytona_concurrency": 1,
    "current_verified_aggregate_memory_gib": 10,
    "current_verified_per_sandbox_storage_gib": 10,
    "experiment_isolation": [
      "process",
      "compose_project",
      "gitea_instance",
      "gitea_volume",
      "runner",
      "vigil",
      "artifact_root"
    ]
  },
  "experiments": [
    {
      "experiment_id": "ordinary-1-glm53-v0-r5",
      "rounds": 5,
      "task_ids": ["O03"],
      "interaction_assignment": {
        "O03": "simulated_user"
      },
      "artifact_root": "runs/ordinary-1-glm53-v0-r5"
    },
    {
      "experiment_id": "ordinary-4-glm53-v0-r5",
      "rounds": 5,
      "task_ids": ["O03", "O09", "O14", "O18"],
      "interaction_assignment": {
        "O03": "simulated_user",
        "O09": "direct",
        "O14": "simulated_user",
        "O18": "benchmark_native_user"
      },
      "artifact_root": "runs/ordinary-4-glm53-v0-r5"
    }
  ],
  "result_contract": {
    "trial_result": "{artifact_root}/round-{round}/trials/{task_id}/result.json",
    "session": "{artifact_root}/round-{round}/trials/{task_id}/session.json",
    "trace": "{artifact_root}/round-{round}/trials/{task_id}/trace.jsonl",
    "grader": "{artifact_root}/round-{round}/trials/{task_id}/grader.json",
    "round_checkpoint": "{artifact_root}/checkpoints/round-{round}.json",
    "round_checkpoint_archive": "{artifact_root}/checkpoints/round-{round}.tar.gz",
    "summary": "{artifact_root}/summary.json"
  },
  "scoring_rules": {
    "official_grader_only": true,
    "infrastructure_failures_excluded": true,
    "artifact_canary_reward_is_not_benchmark_score": true,
    "report_round_and_final_metrics_together": true
  }
}
