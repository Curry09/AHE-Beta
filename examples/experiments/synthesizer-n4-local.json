{
  "schema_version": 2,
  "name": "synthesizer-n4-local",
  "runtime": {
    "backend": "local",
    "gitea": {
      "provider": "localhost",
      "repository_prefix": "synthesizer-n4"
    },
    "local": {
      "ci_enabled": false
    }
  },
  "harness": {
    "source": "builtin"
  },
  "workload": {
    "task_packages": [
      "../tasks/pvlib-1478/task.json",
      "../tasks/order-service/task.json"
    ],
    "persona_library": "../personas/library.json",
    "persona_ids": [
      "sr-01-willison",
      "sr-02-ronacher",
      "sr-07-baldur",
      "sr-15-swyx"
    ],
    "interaction_plan": [
      [
        [
          "sr-01-willison",
          "pvlib__pvlib-python-1478"
        ],
        [
          "sr-02-ronacher",
          "pvlib__pvlib-python-1478"
        ],
        [
          "sr-07-baldur",
          "order-service"
        ],
        [
          "sr-15-swyx",
          "order-service"
        ]
      ],
      [
        [
          "sr-01-willison",
          "order-service"
        ],
        [
          "sr-02-ronacher",
          "order-service"
        ],
        [
          "sr-07-baldur",
          "pvlib__pvlib-python-1478"
        ],
        [
          "sr-15-swyx",
          "pvlib__pvlib-python-1478"
        ]
      ]
    ]
  },
  "rounds": {
    "count": 2,
    "sessions_per_round": 4,
    "max_parallel_users": 2
  },
  "roles": {
    "triager": 1,
    "synthesizer": 1,
    "divergent": 0,
    "owner_mode": "mechanical",
    "developer": 1
  },
  "models": {
    "user": {
      "model": "claude-opus-5-5",
      "base_url_env": "USER_LLM_BASE_URL",
      "api_key_env": "USER_LLM_API_KEY"
    },
    "harness": {
      "model": "claude-opus-5-5",
      "base_url_env": "HARNESS_LLM_BASE_URL",
      "api_key_env": "HARNESS_LLM_API_KEY"
    },
    "demand": {
      "model": "claude-opus-5-5",
      "base_url_env": "DEMAND_LLM_BASE_URL",
      "api_key_env": "DEMAND_LLM_API_KEY"
    },
    "delivery": {
      "backend": "claude-code",
      "model": "claude-opus-5-5",
      "base_url_env": "ANTHROPIC_BASE_URL",
      "api_key_env": "ANTHROPIC_AUTH_TOKEN",
      "auth_type": "bearer"
    }
  },
  "evaluation": {
    "official_grading": false
  },
  "policies": {
    "synthesizer_grouping": false,
    "timing": {
      "latency_isolated": false,
      "wall_guard_seconds": 0
    },
    "delivery": {
      "timeout_seconds": 86400,
      "poll_seconds": 15,
      "coordination": "soft",
      "permission_mode": "bypassPermissions",
      "idle_timeout_seconds": 300
    },
    "alarms": {
      "proposal_depth": 20,
      "ready_depth": 20
    }
  }
}
