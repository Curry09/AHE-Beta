{
  "schema_version": 2,
  "name": "u1-local",
  "runtime": {
    "backend": "local",
    "gitea": {
      "provider": "localhost",
      "repository_prefix": "u1"
    },
    "local": {
      "ci_enabled": false
    }
  },
  "harness": {
    "source": "builtin"
  },
  "workload": {
    "kind": "swebench",
    "task_package": "../tasks/pvlib-1478/task.json",
    "persona_library": "../personas/u1.json",
    "persona_ids": [
      "sr-15-swyx"
    ]
  },
  "rounds": {
    "count": 5,
    "sessions_per_round": 1,
    "max_parallel_users": 1
  },
  "roles": {
    "triager": 1,
    "synthesizer": 1,
    "divergent": 0,
    "owner_mode": "mechanical",
    "developer": 1
  },
  "models": {
    "user": {
      "model": "claude-opus-5-5",
      "base_url_env": "USER_LLM_BASE_URL",
      "api_key_env": "USER_LLM_API_KEY"
    },
    "harness": {
      "model": "claude-opus-5-5",
      "base_url_env": "HARNESS_LLM_BASE_URL",
      "api_key_env": "HARNESS_LLM_API_KEY"
    },
    "demand": {
      "model": "claude-opus-5-5",
      "base_url_env": "DEMAND_LLM_BASE_URL",
      "api_key_env": "DEMAND_LLM_API_KEY"
    },
    "delivery": {
      "backend": "claude-code",
      "model": "claude-opus-5-5",
      "base_url_env": "ANTHROPIC_BASE_URL",
      "api_key_env": "ANTHROPIC_AUTH_TOKEN",
      "auth_type": "bearer"
    }
  },
  "evaluation": {
    "official_grading": false
  },
  "policies": {
    "synthesizer_grouping": false,
    "timing": {
      "latency_isolated": false,
      "wall_guard_seconds": 0
    },
    "delivery": {
      "timeout_seconds": 86400,
      "poll_seconds": 15,
      "coordination": "soft",
      "permission_mode": "bypassPermissions",
      "idle_timeout_seconds": 300
    },
    "alarms": {
      "proposal_depth": 20,
      "ready_depth": 20
    }
  }
}
