# Spec-0069/T6: copy to .env.experiment and chmod 600; fill every model field.
# User, Harness and demand use an OpenAI-compatible Chat Completions endpoint.
USER_LLM_BASE_URL=https://your-model-provider.example/v1
USER_LLM_API_KEY=
HARNESS_LLM_BASE_URL=https://your-model-provider.example/v1
HARNESS_LLM_API_KEY=
DEMAND_LLM_BASE_URL=https://your-model-provider.example/v1
DEMAND_LLM_API_KEY=
# OpenAgents delivery uses Claude Code and an Anthropic-compatible endpoint.
# This example uses AUTH_TOKEN; to use API_KEY change the JSON api_key_env too.
ANTHROPIC_BASE_URL=https://your-anthropic-provider.example
ANTHROPIC_AUTH_TOKEN=
# Only the e2b backend needs these two provider credentials.
E2B_API_KEY=
GITEA_TOKEN=
# Optional: expected Gitea.com username; the backend resolves identity via API.
GITEA_USER=
