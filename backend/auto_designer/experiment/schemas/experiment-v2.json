{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 2
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "backend": {
          "enum": [
            "local",
            "e2b"
          ]
        },
        "gitea": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "provider": {
              "enum": [
                "localhost",
                "gitea.com"
              ]
            },
            "repository_prefix": {
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9-]{0,39}$"
            }
          },
          "required": [
            "provider",
            "repository_prefix"
          ]
        },
        "local": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "gitea_image": {
              "type": "string",
              "minLength": 1
            },
            "vigil_image": {
              "type": "string",
              "minLength": 1
            },
            "egress_image": {
              "type": "string",
              "minLength": 1
            },
            "seed_image": {
              "type": "string",
              "minLength": 1
            },
            "ci_enabled": {
              "const": false
            }
          },
          "required": []
        },
        "e2b": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "template": {
              "type": "string",
              "minLength": 1
            },
            "cpu_count": {
              "type": "integer",
              "minimum": 1
            },
            "memory_mb": {
              "type": "integer",
              "minimum": 512
            },
            "timeout_seconds": {
              "type": "integer",
              "minimum": 300,
              "maximum": 86400
            }
          },
          "required": [
            "cpu_count",
            "memory_mb",
            "timeout_seconds"
          ]
        }
      },
      "required": [
        "backend",
        "gitea"
      ]
    },
    "harness": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "source": {
          "enum": [
            "builtin",
            "archive"
          ]
        },
        "archive": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": [
        "source"
      ]
    },
    "workload": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "ordinary",
            "swebench"
          ]
        },
        "task_package": {
          "type": "string",
          "minLength": 1
        },
        "persona_library": {
          "type": "string",
          "minLength": 1
        },
        "persona_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "required": [
        "kind",
        "task_package",
        "persona_library",
        "persona_ids"
      ]
    },
    "rounds": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "count": {
          "type": "integer",
          "minimum": 1
        },
        "sessions_per_round": {
          "type": "integer",
          "minimum": 1
        },
        "max_parallel_users": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [
        "count",
        "sessions_per_round",
        "max_parallel_users"
      ]
    },
    "roles": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "triager": {
          "type": "integer",
          "minimum": 0
        },
        "synthesizer": {
          "type": "integer",
          "minimum": 0
        },
        "divergent": {
          "type": "integer",
          "minimum": 0
        },
        "owner_mode": {
          "const": "mechanical"
        },
        "developer": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [
        "triager",
        "synthesizer",
        "divergent",
        "owner_mode",
        "developer"
      ]
    },
    "models": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "user": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "model": {
              "type": "string",
              "minLength": 1
            },
            "base_url_env": {
              "type": "string",
              "pattern": "^[A-Z][A-Z0-9_]*$"
            },
            "api_key_env": {
              "type": "string",
              "pattern": "^[A-Z][A-Z0-9_]*$"
            }
          },
          "required": [
            "model",
            "base_url_env",
            "api_key_env"
          ]
        },
        "harness": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "model": {
              "type": "string",
              "minLength": 1
            },
            "base_url_env": {
              "type": "string",
              "pattern": "^[A-Z][A-Z0-9_]*$"
            },
            "api_key_env": {
              "type": "string",
              "pattern": "^[A-Z][A-Z0-9_]*$"
            }
          },
          "required": [
            "model",
            "base_url_env",
            "api_key_env"
          ]
        },
        "demand": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "model": {
              "type": "string",
              "minLength": 1
            },
            "base_url_env": {
              "type": "string",
              "pattern": "^[A-Z][A-Z0-9_]*$"
            },
            "api_key_env": {
              "type": "string",
              "pattern": "^[A-Z][A-Z0-9_]*$"
            }
          },
          "required": [
            "model",
            "base_url_env",
            "api_key_env"
          ]
        },
        "delivery": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "model": {
              "type": "string",
              "minLength": 1
            },
            "base_url_env": {
              "type": "string",
              "pattern": "^[A-Z][A-Z0-9_]*$"
            },
            "api_key_env": {
              "type": "string",
              "pattern": "^[A-Z][A-Z0-9_]*$"
            },
            "backend": {
              "const": "claude-code"
            }
          },
          "required": [
            "model",
            "base_url_env",
            "api_key_env",
            "backend"
          ]
        }
      },
      "required": [
        "user",
        "harness",
        "demand",
        "delivery"
      ]
    },
    "evaluation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "official_grading": {
          "const": false
        }
      },
      "required": [
        "official_grading"
      ]
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "openagents": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "repository": {
              "type": "string",
              "minLength": 1
            },
            "revision": {
              "type": "string",
              "pattern": "^[a-f0-9]{40}$"
            }
          },
          "required": [
            "repository",
            "revision"
          ]
        },
        "nexau": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "repository": {
              "type": "string",
              "minLength": 1
            },
            "revision": {
              "type": "string",
              "pattern": "^[a-f0-9]{40}$"
            }
          },
          "required": [
            "repository",
            "revision"
          ]
        }
      },
      "required": []
    }
  },
  "required": [
    "schema_version",
    "name",
    "runtime",
    "harness",
    "workload",
    "rounds",
    "roles",
    "models",
    "evaluation"
  ]
}
