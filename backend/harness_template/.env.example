# Harness runtime configuration.
# Copy to .env for local runs. Do not commit a filled .env file.

LLM_MODEL=your-model-here
LLM_BASE_URL=https://your-endpoint.example.com/v1
LLM_API_KEY=sk-your-api-key-here

# Optional: project workspace where file edits and shell commands run.
# If unset, entry.py creates a temporary workspace for the process.
SANDBOX_WORK_DIR=/absolute/path/to/project
