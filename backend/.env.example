# 三种角色各自独立配置 model/api_key/base_url（无公共回落，三组都必须填全）：
#   USER_*     用户 agent（persona 模拟）
#   DEV_*      开发者 agent（改 harness + 直推 main）
#   DESIGNER_* 创新者 agent（读现状产提案）
#
# 用法：cp backend/.env.example backend/.env 后填入真实凭证（.env 已被 .gitignore 忽略，勿提交）。
USER_LLM_MODEL=your-model-here
USER_LLM_API_KEY=sk-your-api-key-here
USER_LLM_BASE_URL=https://your-endpoint.example.com/v1

DEV_LLM_MODEL=your-model-here
DEV_LLM_API_KEY=sk-your-api-key-here
DEV_LLM_BASE_URL=https://your-endpoint.example.com/v1

DESIGNER_LLM_MODEL=your-model-here
DESIGNER_LLM_API_KEY=sk-your-api-key-here
DESIGNER_LLM_BASE_URL=https://your-endpoint.example.com/v1
