# Legacy backend/run.py local model configuration. Copy to backend/.env.
# Auditable experiments use examples/models.env.example in a 0600 named profile instead.
# USER = simulated user; DEMAND = demand-side roles; HARNESS = product under test.
# Delivery is a separate OpenAgents CLI; DEV_LLM_* is not consumed here.
USER_LLM_MODEL=your-model
USER_LLM_API_KEY=replace-locally
USER_LLM_BASE_URL=https://gateway.example/v1

DEMAND_LLM_MODEL=your-model
DEMAND_LLM_API_KEY=replace-locally
DEMAND_LLM_BASE_URL=https://gateway.example/v1

HARNESS_LLM_MODEL=your-model
HARNESS_LLM_API_KEY=replace-locally
HARNESS_LLM_BASE_URL=https://gateway.example/v1

# For Claude Code delivery, configure an Anthropic-compatible gateway or your CLI login.
# ANTHROPIC_BASE_URL=https://messages.example
# ANTHROPIC_AUTH_TOKEN=replace-locally
# ANTHROPIC_MODEL=your-delivery-model
# ANTHROPIC_SMALL_FAST_MODEL=your-delivery-model

# Demand role roster and optional structural grouping.
N_SYNTHESIZERS=1
SYNTHESIZER_GROUPING=0
# DEMAND_LLM_REASONING_EFFORT=medium
