{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "materials",
    "graders"
  ],
  "properties": {
    "schema_version": {
      "const": 1,
      "type": "integer"
    },
    "materials": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"
      },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "sha256"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      }
    },
    "graders": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "adapter",
          "contract_version",
          "task_ids",
          "inputs",
          "timeout_seconds"
        ],
        "properties": {
          "adapter": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*$"
          },
          "contract_version": {
            "const": 1,
            "type": "integer"
          },
          "task_ids": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "inputs": {
            "type": "object",
            "additionalProperties": {
              "type": "string",
              "minLength": 1
            }
          },
          "timeout_seconds": {
            "type": "integer",
            "minimum": 1,
            "maximum": 86400
          },
          "config": {
            "type": "object"
          }
        }
      }
    }
  }
}
