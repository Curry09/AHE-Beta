{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1
    },
    "kind": {
      "enum": [
        "ordinary",
        "swebench"
      ]
    },
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"
    },
    "instruction_file": {
      "type": "string",
      "minLength": 1
    },
    "source": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "git"
            },
            "url": {
              "type": "string",
              "minLength": 1
            },
            "revision": {
              "type": "string",
              "pattern": "^[a-f0-9]{40}$"
            },
            "repo": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
            }
          },
          "required": [
            "kind",
            "url",
            "revision",
            "repo"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "kind": {
              "const": "local"
            },
            "path": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "kind",
            "path"
          ]
        }
      ]
    },
    "setup": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "script": {
          "type": "string",
          "minLength": 1
        },
        "requirements_lock": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "script",
        "requirements_lock"
      ]
    },
    "difficulty": {
      "type": "string",
      "minLength": 1
    },
    "not_in_benchmark": {
      "const": true
    },
    "interaction": {
      "enum": [
        "simulated_user",
        "direct"
      ]
    }
  },
  "required": [
    "schema_version",
    "kind",
    "id",
    "instruction_file",
    "source",
    "setup"
  ]
}
